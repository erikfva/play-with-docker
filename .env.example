PORT=3000
# Set NODE_ENV="local" to read credentials from S3_MOUNT_DIR instead of S3.
# NODE_ENV="local"
# PostgreSQL connection URL (used by src/db/db.js)
DATABASE_URL_CONN="postgres://postgres:postgres@localhost:5432/play_with_docker"
# Provider credentials are supplied per create request, for example:
# x-google-credentials: gcloud/service-account-key.json
# x-codesandbox-credentials: codesandbox/account.json
SERVER_TOKEN="change-me"

# Mount settings (required)
S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
S3FS_ENABLED="1"

# Where to mount the bucket inside the container
S3_MOUNT_DIR="/mnt/s3"

# AWS S3 only (example: us-east-1). Leave empty for iDrive E2.
S3_REGION=""

# iDrive E2 / S3-compatible only (example: https://xxxxx.idrivee2-xx.com). Leave empty for AWS S3.
S3_ENDPOINT=""

# Optional
AWS_SESSION_TOKEN=""
S3FS_EXTRA_OPTS="-o umask=0022 -o nonempty"

# When S3FS_ENABLED="0", request credential references are interpreted as:
# - s3://bucket/key.json
# - or a bucket-relative key like "path/to/key.json" (uses S3_BUCKET)
#
# When NODE_ENV="local", credentials are read from S3_MOUNT_DIR instead of S3.
# Relative references and s3://bucket/key.json references resolve to files under S3_MOUNT_DIR.
