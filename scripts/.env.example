# scripts/.env.example — environment template for helper scripts
# Copy to `scripts/.env` or to the project root `.env` (both work):
#   cp scripts/.env.example scripts/.env   # loaded when run from scripts/
#   cp scripts/.env.example .env            # loaded when run from repo root
# CLI flags (--url, --token) always win over env vars.
#
# See scripts/README.md for script docs and .env.example at the repo root
# for the full server env template.

# ── API (refresh-vps-status.js, seed-credentials.js) ────────────────────────
# Base URL — precedence: --url flag > PWD_API_URL > http://localhost:$PORT > http://localhost:3000
PWD_API_URL="http://localhost:3000"
# PORT fallback when PWD_API_URL is not set (also used by the server)
PORT=3000
# Server token — sent as `x-server-token` header (required)
SERVER_TOKEN="change-me"

# ── CodeSandbox — test-codesandbox-api.sh ───────────────────────────────────
# API token for @codesandbox/sdk smoke test (one of the two names is enough)
CSB_API_KEY=""
CODESANDBOX_API_KEY=""
# Optional: keep the sandbox after the test (0 = delete, 1 = keep)
KEEP_SANDBOX="0"
# Optional: sandbox title used by the smoke test
SANDBOX_TITLE="api-token-smoke-test"
# Optional: custom env file path for the shell script (default: <repo>/.env)
ENV_FILE=""

# ── GitHub Codespaces — check-codespaces-create.sh ──────────────────────────
# Path to the `gh` binary (default: gh on PATH)
GH_BIN="gh"
# Repository id used when probing POST /user/codespaces creation throttle
CODESPACES_DEFAULT_REPOSITORY_ID=""
