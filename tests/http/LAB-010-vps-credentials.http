@baseUrl = http://localhost:3200/api/v1
@serverToken = {{$dotenv SERVER_TOKEN}}

###
# ─────────────────────────────────────────────────────────────────────────────
# LAB-010: VPS Credential Store
# Tests the /api/v1/vps CRUD endpoints and DB-first credential resolution.
# ─────────────────────────────────────────────────────────────────────────────

@codespacesCredentials = vm-manager123

### 30. List All VPS Records (empty on a fresh DB)
GET {{baseUrl}}/vps
X-Server-Token: {{serverToken}}

### 30.1. List VPS Records Filtered by Provider
GET {{baseUrl}}/vps?provider=codespaces
X-Server-Token: {{serverToken}}

### 30.2. List VPS Records — Invalid Provider Filter
# Expected: 400 VPS_INVALID_PROVIDER
GET {{baseUrl}}/vps?provider=unknown
X-Server-Token: {{serverToken}}

### 31. Register a Codespaces VPS Record
# @name createVpsCodespaces
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "vm-manager-smoke",
    "credentialFileName": "vm-manager-smoke.json",
    "credentialContent": "{\"token\":\"ghp_smoke_test_placeholder\"}"
}

###
@vpsCodespacesId = {{createVpsCodespaces.response.body.$.id}}
# @vpsCodespacesId = 00000000-0000-0000-0000-000000000000

### 31.1. Register a Codespaces VPS — Plain-Text PAT format
# @name createVpsCodespacesPlainText
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "vm-manager-plaintext",
    "credentialFileName": "vm-manager-plaintext.txt",
    "credentialContent": "ghp_smoke_test_plaintext_placeholder"
}

### 31.2. Register a CodeSandbox VPS Record
# @name createVpsCodeSandbox
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codesandbox",
    "name": "csb-smoke",
    "credentialFileName": "csb-smoke.json",
    "credentialContent": "{\"token\":\"csb_smoke_test_placeholder\"}"
}

###
@vpsCodeSandboxId = {{createVpsCodeSandbox.response.body.$.id}}

### 31.3. Register a GCS VPS Record
# @name createVpsGcs
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "gcs",
    "name": "gcs-smoke",
    "credentialFileName": "gcs-smoke.json",
    "credentialContent": "{\"type\":\"service_account\",\"project_id\":\"smoke-project\",\"private_key_id\":\"abc123\",\"private_key\":\"-----BEGIN RSA PRIVATE KEY-----\\nMIIEowIBAAKCAQEA0Z3VS5JJcds3xHn/ygWep4PAtEsHAEOGGXQqFMuoxsT0JJLZ\\n-----END RSA PRIVATE KEY-----\\n\",\"client_email\":\"smoke@smoke-project.iam.gserviceaccount.com\",\"client_id\":\"123456789\",\"auth_uri\":\"https://accounts.google.com/o/oauth2/auth\",\"token_uri\":\"https://oauth2.googleapis.com/token\"}"
}

###
@vpsGcsId = {{createVpsGcs.response.body.$.id}}

### 32. Duplicate Name
# Expected: 409 VPS_ALREADY_EXISTS
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "vm-manager-smoke",
    "credentialFileName": "vm-manager-smoke-dupe.json",
    "credentialContent": "{\"token\":\"ghp_completely_different_token\"}"
}

### 32.1. Duplicate Token
# Expected: 409 VPS_DUPLICATE_TOKEN
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "vm-manager-smoke-alias",
    "credentialFileName": "vm-manager-smoke-alias.json",
    "credentialContent": "{\"token\":\"ghp_smoke_test_placeholder\"}"
}

### 32.2. Invalid Provider
# Expected: 400 VPS_INVALID_PROVIDER
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "aws",
    "name": "bad-provider",
    "credentialFileName": "bad.json",
    "credentialContent": "{\"token\":\"whatever\"}"
}

### 32.3. Name With Path Separator
# Expected: 400 VPS_NAME_INVALID
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "../../etc/passwd",
    "credentialFileName": "evil.json",
    "credentialContent": "{\"token\":\"ghp_evil\"}"
}

### 32.4. CodeSandbox Plain-Text Credential
# Expected: 400 CODESANDBOX_CREDENTIALS_INVALID — plain text rejected for CodeSandbox
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codesandbox",
    "name": "csb-invalid-plaintext",
    "credentialFileName": "csb-invalid.txt",
    "credentialContent": "csb_plain_text_token_not_allowed"
}

### 32.5. Codespaces JSON Without token Field
# Expected: 400 CODESPACES_NO_CREDENTIAL — valid JSON but missing token field
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "csp-no-token-field",
    "credentialFileName": "csp-no-token.json",
    "credentialContent": "{\"user\":\"not-a-token\"}"
}

### 32.6. GCS Without type Field
# Expected: 400 GCS_CREDENTIALS_INVALID
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "gcs",
    "name": "gcs-no-type",
    "credentialFileName": "gcs-no-type.json",
    "credentialContent": "{\"project_id\":\"missing-type-field\"}"
}

### 33. Get VPS Record by ID
GET {{baseUrl}}/vps/{{vpsCodespacesId}}
X-Server-Token: {{serverToken}}

### 33.1. Get VPS Record — Not Found
# Expected: 404 VPS_NOT_FOUND
GET {{baseUrl}}/vps/00000000-0000-0000-0000-000000000000
X-Server-Token: {{serverToken}}

### 34. Update VPS — Change credentialFileName Only (no re-fingerprinting)
PUT {{baseUrl}}/vps/{{vpsCodespacesId}}
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "credentialFileName": "vm-manager-smoke-v2.json"
}

### 34.1. Update VPS — Replace credentialContent (re-fingerprints)
# @name updateVpsCodespaces
PUT {{baseUrl}}/vps/{{vpsCodespacesId}}
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "credentialContent": "{\"token\":\"ghp_updated_smoke_token\"}"
}

### 34.2. Update VPS — No Fields Provided
# Expected: 400 VPS_CONTENT_INVALID
PUT {{baseUrl}}/vps/{{vpsCodespacesId}}
Content-Type: application/json
X-Server-Token: {{serverToken}}

{}

### 34.3. Update VPS — Not Found
# Expected: 404 VPS_NOT_FOUND
PUT {{baseUrl}}/vps/00000000-0000-0000-0000-000000000000
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "credentialFileName": "does-not-matter.json"
}

### 35. List All VPS — Verify Records Exist After Creates
GET {{baseUrl}}/vps
X-Server-Token: {{serverToken}}

###
# DB-First Resolution Smoke Tests
# Placeholder tokens fail at the provider level (not credential resolution),
# which confirms DB lookup succeeded.

### 36. Create Codespaces Session Using DB VPS Name as credentialRef
# Expected: provider-level failure (invalid token), NOT credential-not-found
POST http://localhost:3200/api/v1/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-Codespaces-Credentials: vm-manager-smoke

{
    "provider": "codespaces"
}

### 36.1. Create CodeSandbox Session Using DB VPS Name as credentialRef
# Expected: provider-level failure (invalid token), NOT credential-not-found
POST http://localhost:3200/api/v1/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-CodeSandbox-Credentials: csb-smoke

{
    "provider": "codesandbox"
}

### 36.2. Create Codespaces Session Using Real VPS Name (live PAT)
# @name createCodespacesSessionFromVps
POST http://localhost:3200/api/v1/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-Codespaces-Credentials: {{codespacesCredentials}}

{
    "provider": "codespaces"
}

###
@codespacesVpsSessionId = {{createCodespacesSessionFromVps.response.body.$.id}}

### 36.3. Terminate Live VPS-Resolved Codespaces Session
DELETE http://localhost:3200/api/v1/sessions/{{codespacesVpsSessionId}}
X-Server-Token: {{serverToken}}

### 37. Delete VPS
# Expected: 204 No Content
DELETE {{baseUrl}}/vps/{{vpsCodespacesId}}
X-Server-Token: {{serverToken}}

### 37.1. Delete VPS — Not Found
# Expected: 404 VPS_NOT_FOUND
DELETE {{baseUrl}}/vps/00000000-0000-0000-0000-000000000000
X-Server-Token: {{serverToken}}

### 37.2. Delete VPS — Blocked by Active Session
# Step A: register the credential
# @name createVpsForBlockTest
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "vm-block-test",
    "credentialFileName": "vm-block-test.json",
    "credentialContent": "{\"token\":\"ghp_block_test_placeholder\"}"
}

###
@vpsBlockTestId = {{createVpsForBlockTest.response.body.$.id}}

### 37.2-B. Attempt delete before any session (should succeed — 204)
DELETE {{baseUrl}}/vps/{{vpsBlockTestId}}
X-Server-Token: {{serverToken}}

### 38. Cleanup — Delete Remaining VPS Test Records
DELETE {{baseUrl}}/vps/{{vpsCodeSandboxId}}
X-Server-Token: {{serverToken}}

###
DELETE {{baseUrl}}/vps/{{vpsGcsId}}
X-Server-Token: {{serverToken}}
