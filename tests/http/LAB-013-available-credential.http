@baseUrl = http://localhost:3200/api/v1
@serverToken = {{$dotenv SERVER_TOKEN}}

###
# ─────────────────────────────────────────────────────────────────────────────
# LAB-013: Available Credential Selection — GET /api/v1/vps/available-credential
# Spec: ai/project-overview.md → "VPS Credential Selection"
# Pre-condition: server running on localhost:3200 with a fresh or existing DB.
# Env: SERVER_TOKEN must be set (see 000-variables.http / .env).
#
# This file creates its own isolated fixtures (vm-lab013-*) so it can run
# standalone; it does not depend on LAB-010/011/012 having been run first.
#
# Endpoint contract (as implemented):
#   GET /api/v1/vps/available-credential?provider=gcs|codesandbox|codespaces
#   200 → { provider, strategy, credentialRef, credential, credentialFingerprint,
#           status, statusCheckedAt, inUse, inUseKnown, coreHoursRemaining }
#   400 → VPS_INVALID_PARAM   (missing / empty / unsupported provider)
#   401 → Unauthorized        (missing or wrong server token)
#   409 → NO_AVAILABLE_CREDENTIAL (no usable credential for the provider)
#
# Strategy: "first-available" for gcs/codesandbox (registration order),
#           "max-core-hours" for codespaces (most remaining compute).
# ─────────────────────────────────────────────────────────────────────────────

###
# ── Fixture names (unique per lab to avoid collisions) ──────────────────────
@vpsLab013CspAName = vm-lab013-csp-a
@vpsLab013CspBName = vm-lab013-csp-b
@vpsLab013CsbAName = vm-lab013-csb-a
@vpsLab013CsbBName = vm-lab013-csb-b
@vpsLab013GcsName  = vm-lab013-gcs

###
# ── Optional pre-conditions (declared before use — REST Client resolves
#    variables lazily, but keeping them at the top makes the file readable) ──

# A real Codespaces PAT / VPS name, used by §58.1 and §59.1.
# @codespacesCredentials = vm-manager123
# @vpsLab013RealCspId = 00000000-0000-0000-0000-000000000000
# A real registered GCS credential name, used by §59.5.
# @gcsCredentials = gcloud/real-account.json

###
# ── 54. Create fixtures (isolated to this lab) ─────────────────────────────

### 54.0. Baseline — list VPS records before creating fixtures
# Expected: 200 { vps: [...], total, limit, offset }
GET {{baseUrl}}/vps
X-Server-Token: {{serverToken}}

### 54.1. Create Codespaces VPS A — JSON token form
# @name createVpsLab013CspA
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "{{vpsLab013CspAName}}",
    "credentialFileName": "{{vpsLab013CspAName}}.json",
    "credentialContent": "{\"token\":\"ghp_lab013_smoke_placeholder_csp_a\"}"
}

###
@vpsLab013CspAId = {{createVpsLab013CspA.response.body.$.id}}

### 54.2. Create Codespaces VPS B — JSON token form
# @name createVpsLab013CspB
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "{{vpsLab013CspBName}}",
    "credentialFileName": "{{vpsLab013CspBName}}.json",
    "credentialContent": "{\"token\":\"ghp_lab013_smoke_placeholder_csp_b\"}"
}

###
@vpsLab013CspBId = {{createVpsLab013CspB.response.body.$.id}}

### 54.3. Create CodeSandbox VPS A — JSON token form
# @name createVpsLab013CsbA
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codesandbox",
    "name": "{{vpsLab013CsbAName}}",
    "credentialFileName": "{{vpsLab013CsbAName}}.json",
    "credentialContent": "{\"token\":\"csb_lab013_smoke_placeholder_csb_a\"}"
}

###
@vpsLab013CsbAId = {{createVpsLab013CsbA.response.body.$.id}}

### 54.4. Create CodeSandbox VPS B — JSON token form
# @name createVpsLab013CsbB
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codesandbox",
    "name": "{{vpsLab013CsbBName}}",
    "credentialFileName": "{{vpsLab013CsbBName}}.json",
    "credentialContent": "{\"token\":\"csb_lab013_smoke_placeholder_csb_b\"}"
}

###
@vpsLab013CsbBId = {{createVpsLab013CsbB.response.body.$.id}}

### 54.5. Create GCS VPS — service-account JSON (synthetic; never hits Google on create)
# @name createVpsLab013Gcs
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "gcs",
    "name": "{{vpsLab013GcsName}}",
    "credentialFileName": "{{vpsLab013GcsName}}.json",
    "credentialContent": "{\"type\":\"service_account\",\"project_id\":\"lab013-smoke\",\"private_key_id\":\"lab013\",\"private_key\":\"-----BEGIN RSA PRIVATE KEY-----\\nMIIEowIBAAKCAQEA0Z3VS5JJcds3xHn/ygWep4PAtEsHAEOGGXQqFMuoxsT0JJLZ\\n-----END RSA PRIVATE KEY-----\\n\",\"client_email\":\"lab013@lab013-smoke.iam.gserviceaccount.com\",\"client_id\":\"999\",\"auth_uri\":\"https://accounts.google.com/o/oauth2/auth\",\"token_uri\":\"https://oauth2.googleapis.com/token\"}"
}


###
# ── 55. Error paths — parameter validation and auth ────────────────────────

### 55.1. Missing provider → 400 VPS_INVALID_PARAM
# Expected: 400 { error, code: "VPS_INVALID_PARAM" }
GET {{baseUrl}}/vps/available-credential
X-Server-Token: {{serverToken}}

### 55.2. Empty provider → 400 VPS_INVALID_PARAM
# Expected: 400 VPS_INVALID_PARAM
GET {{baseUrl}}/vps/available-credential?provider=
X-Server-Token: {{serverToken}}

### 55.3. Unsupported provider → 400 VPS_INVALID_PARAM
# Expected: 400 VPS_INVALID_PARAM (not VPS_INVALID_PROVIDER — this route uses the GET-list code)
GET {{baseUrl}}/vps/available-credential?provider=aws
X-Server-Token: {{serverToken}}

### 55.4. Provider is case-sensitive — "GCS" → 400 VPS_INVALID_PARAM
GET {{baseUrl}}/vps/available-credential?provider=GCS
X-Server-Token: {{serverToken}}

### 55.5. Stub provider "pwd" is not selectable → 400 VPS_INVALID_PARAM
GET {{baseUrl}}/vps/available-credential?provider=pwd
X-Server-Token: {{serverToken}}

### 55.6. Missing server token → 401 Unauthorized
# Expected: 401 { error: "Unauthorized" }
GET {{baseUrl}}/vps/available-credential?provider=gcs

### 55.7. Wrong server token → 401 Unauthorized
GET {{baseUrl}}/vps/available-credential?provider=gcs
X-Server-Token: definitely-not-the-server-token

### 55.8. Bearer token is accepted as an alternative to X-Server-Token
# Expected: 200 (same body as §56.1)
GET {{baseUrl}}/vps/available-credential?provider=gcs
Authorization: Bearer {{serverToken}}

###
# ── 56. Happy path — selection per provider ─────────────────────────────────

### 56.1. GCS → 200, strategy "first-available"
# Expected: 200; strategy="first-available"; credentialRef is a GCS VPS name;
# inUse=false; inUseKnown=true (GCS is matched on stored credentialRef);
# coreHoursRemaining=null.
GET {{baseUrl}}/vps/available-credential?provider=gcs
X-Server-Token: {{serverToken}}

### 56.2. CodeSandbox → 200, strategy "first-available"
# Expected: 200; strategy="first-available"; inUseKnown=true (CodeSandbox
# enforces one active session per token, so a credential backing a live
# session is skipped).
GET {{baseUrl}}/vps/available-credential?provider=codesandbox
X-Server-Token: {{serverToken}}

### 56.3. Codespaces → 200, strategy "max-core-hours"
# Expected: 200; strategy="max-core-hours" (not "first-available");
# inUseKnown=true.
GET {{baseUrl}}/vps/available-credential?provider=codespaces
X-Server-Token: {{serverToken}}

### 56.4. Response envelope — every documented field must be present
# Expected: 200; body has provider, strategy, credentialRef, credential,
# credentialFingerprint, status, statusCheckedAt, inUse, inUseKnown,
# coreHoursRemaining. credentialContent must never be present.
GET {{baseUrl}}/vps/available-credential?provider=codesandbox
X-Server-Token: {{serverToken}}

###
@vpsLab013GcsId = {{createVpsLab013Gcs.response.body.$.id}}


###
# ── 57. Unusable credentials are skipped (409 NO_AVAILABLE_CREDENTIAL) ──────

### 57.1. Exhaust CodeSandbox A (credits quota exhausted → QUOTA_EXHAUSTED)
# Expected: 200; status.status == "QUOTA_EXHAUSTED"; remaining == 0
PATCH {{baseUrl}}/vps/{{vpsLab013CsbAId}}/status/billing
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "billing": {
        "includedCredits": 400,
        "usedCredits": 400,
        "remainingCredits": 0,
        "billingPeriod": "8 August – 8 September 2026",
        "url": "https://codesandbox.io/t/usage?workspace=ws_lab013",
        "fetchedAt": "2026-09-04T13:00:00.000Z"
    }
}

### 57.2. Exhaust CodeSandbox B as well
# Expected: 200; status.status == "QUOTA_EXHAUSTED"
PATCH {{baseUrl}}/vps/{{vpsLab013CsbBId}}/status/billing
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "billing": {
        "includedCredits": 400,
        "usedCredits": 400,
        "remainingCredits": 0,
        "billingPeriod": "8 August – 8 September 2026",
        "url": "https://codesandbox.io/t/usage?workspace=ws_lab013",
        "fetchedAt": "2026-09-04T13:00:00.000Z"
    }
}

### 57.3. Every CodeSandbox credential is unusable → 409 NO_AVAILABLE_CREDENTIAL
# Expected: 409 { code: "NO_AVAILABLE_CREDENTIAL", details: { provider:
# "codesandbox", reason: "ALL_IN_USE_OR_UNUSABLE", considered: 2,
# inUse: 0, unusable: 2 } }
GET {{baseUrl}}/vps/available-credential?provider=codesandbox
X-Server-Token: {{serverToken}}

### 57.4. Restore CodeSandbox A → it becomes selectable again
# Expected: 200; status.status == "AVAILABLE"; remaining == 300
PATCH {{baseUrl}}/vps/{{vpsLab013CsbAId}}/status/billing
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "billing": {
        "includedCredits": 400,
        "usedCredits": 100,
        "remainingCredits": 300,
        "billingPeriod": "8 August – 8 September 2026",
        "url": "https://codesandbox.io/t/usage?workspace=ws_lab013",
        "fetchedAt": "2026-09-04T14:00:00.000Z"
    }
}

### 57.5. CodeSandbox A is available again → 200
# Expected: 200; credentialRef == "vm-lab013-csb-a" (first-available);
# status == "AVAILABLE"; inUse == false
GET {{baseUrl}}/vps/available-credential?provider=codesandbox
X-Server-Token: {{serverToken}}

###
# ── 58. Codespaces — max-core-hours beats registration order ───────────────
# Refreshing a Codespaces credential needs a REAL PAT to report a compute
# quota. With a placeholder token the refresh returns INVALID (see §58.3),
# which is itself a valid check.

### 58.1. Refresh a real Codespaces credential to populate its compute quota
# Pre-condition: set @vpsLab013RealCspId to the id of a Codespaces VPS whose
# credentialContent holds a real PAT (see LAB-010 §31 for how one is created).
# Expected: 200; status.quotas[0].name contains "compute" and
# quotaUnit == "core-hours" (e.g. limit 120, usage 117, remaining 3).
# @name refreshVpsLab013RealCsp
POST {{baseUrl}}/vps/{{vpsLab013RealCspId}}/status/refresh
X-Server-Token: {{serverToken}}

### 58.2. Codespaces selection prefers the credential with the most remaining core-hours
# Expected: 200; strategy == "max-core-hours";
# coreHoursRemaining is a number (not null) when a compute quota is known, and
# the returned credentialRef is the one with the highest remaining core-hours —
# NOT necessarily the first registered one.
GET {{baseUrl}}/vps/available-credential?provider=codespaces
X-Server-Token: {{serverToken}}

### 58.3. Refresh a placeholder Codespaces credential → status becomes INVALID
# Expected: 200; status.status == "INVALID" (placeholder token rejected by
# GitHub). The credential is then skipped by the selection endpoint.
POST {{baseUrl}}/vps/{{vpsLab013CspAId}}/status/refresh
X-Server-Token: {{serverToken}}

### 58.4. Selection still succeeds — the INVALID credential is skipped
# Expected: 200; the returned credentialRef is NOT "vm-lab013-csp-a"
GET {{baseUrl}}/vps/available-credential?provider=codespaces
X-Server-Token: {{serverToken}}

###
# ── 59. In-use credentials are skipped for every provider ───────────────────
# A credential that currently backs a live (non-terminal) session must not be
# handed out again. GCS sessions match the registry credential by credentialRef;
# CodeSandbox and Codespaces match by credential fingerprint.
#
# To exercise this over HTTP you need a real PAT: create a session with the
# credential (LAB-010 §36.2 shows the pattern), then re-run the request below.

### 59.1. Create a Codespaces session from a real VPS credential
# @name createLab013CodespacesSession
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-Codespaces-Credentials: {{codespacesCredentials}}

{
    "provider": "codespaces"
}

###
@codespacesLab013SessionId = {{createLab013CodespacesSession.response.body.$.id}}

### 59.2. The in-use credential is skipped by the selection endpoint
# Expected: 200; the returned credentialRef is not the credential that backs
# the session from §59.1; inUse == false for the returned credential.
GET {{baseUrl}}/vps/available-credential?provider=codespaces
X-Server-Token: {{serverToken}}

### 59.3. Terminate the session — the credential becomes selectable again
# Expected: 204 No Content
DELETE {{baseUrl}}/sessions/{{codespacesLab013SessionId}}
X-Server-Token: {{serverToken}}

### 59.4. Re-run the selection — the previously in-use credential is eligible again
# Expected: 200
GET {{baseUrl}}/vps/available-credential?provider=codespaces
X-Server-Token: {{serverToken}}

### 59.5. Create a GCS session using a real registered credential
# Pre-condition: set @gcsCredentials to the name of a valid, registered GCS VPS
# credential, and ensure at least two GCS credentials are registered and
# eligible. Set @gcsCredentials to the credential selection would otherwise
# return; with only one eligible credential, §59.6 correctly returns 409.
# This verifies that the persisted session credentialRef matches the registry
# name used by available-credential selection.
# @name createLab013GcsSession
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-Google-Credentials: {{gcsCredentials}}

{
    "provider": "gcs"
}

###
@gcsLab013SessionId = {{createLab013GcsSession.response.body.$.id}}

### 59.6. The in-use GCS credential is skipped by selection
# Expected: 200; the returned credentialRef is not {{gcsCredentials}}.
GET {{baseUrl}}/vps/available-credential?provider=gcs
X-Server-Token: {{serverToken}}

### 59.7. Terminate the GCS session and make its credential eligible again
DELETE {{baseUrl}}/sessions/{{gcsLab013SessionId}}
X-Server-Token: {{serverToken}}

### 59.8. Re-run GCS selection — the previously in-use credential is eligible
# Expected: 200; the previously selected credential may now be returned.
GET {{baseUrl}}/vps/available-credential?provider=gcs
X-Server-Token: {{serverToken}}

###
# ── 60. Cleanup — remove the fixtures created by this lab ───────────────────

### 60.1. Delete Codespaces fixture A
DELETE {{baseUrl}}/vps/{{vpsLab013CspAId}}
X-Server-Token: {{serverToken}}

### 60.2. Delete Codespaces fixture B
DELETE {{baseUrl}}/vps/{{vpsLab013CspBId}}
X-Server-Token: {{serverToken}}

### 60.3. Delete CodeSandbox fixture A
DELETE {{baseUrl}}/vps/{{vpsLab013CsbAId}}
X-Server-Token: {{serverToken}}

### 60.4. Delete CodeSandbox fixture B
DELETE {{baseUrl}}/vps/{{vpsLab013CsbBId}}
X-Server-Token: {{serverToken}}

### 60.5. Delete GCS fixture
DELETE {{baseUrl}}/vps/{{vpsLab013GcsId}}
X-Server-Token: {{serverToken}}

### 60.6. Final list — back to the pre-lab total (± concurrent runs)
GET {{baseUrl}}/vps
X-Server-Token: {{serverToken}}
