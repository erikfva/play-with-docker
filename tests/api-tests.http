@baseUrl = http://dockerhost:3200/api/v1
@s3EndPoint = {{$dotenv CODE_S3_ENDPOINT}}
@s3AccessKeyId = {{$dotenv CODE_AWS_ACCESS_KEY_ID}}
@s3SecretAccessKey = {{$dotenv CODE_AWS_SECRET_ACCESS_KEY}}
@s3Region = {{$dotenv CODE_S3_REGION}}
@tokenNgrok = {{$dotenv CODE_TOKEN_NGROK}}
@serverToken = {{$dotenv SERVER_TOKEN}}

### 1. Health Check
GET http://localhost:3000/health

### 2. List Active Sessions
GET {{baseUrl}}/sessions?status=RUNNING
X-Server-Token: {{serverToken}}

@googleCredentials = gcloud/test-credential.json 

### 2.1 List Active Sessions with custom Google Credentials Header
GET {{baseUrl}}/sessions?status=RUNNING
X-Server-Token: {{serverToken}}
X-Google-Credentials: {{googleCredentials}}

### 3. Create a New Cloud Shell Session
# This will trigger the Google Cloud Shell start-up process
# @name createSession
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}

### 3.1. Create a New Cloud Shell Session with custom Google Credentials Header
# This will trigger the Google Cloud Shell start-up process
# @name createSession
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-Google-Credentials: {{googleCredentials}}

###
#@sessionId = c6b2db8a-9426-482e-8207-5e2a707bb0a0
@sessionId = {{createSession.response.body.$.id}}

### 4. Get Session Details and Status
# Use the ID returned from the POST request above
GET {{baseUrl}}/sessions/{{sessionId}}
X-Server-Token: {{serverToken}}

### 5. Execute a Command (Requires SSH setup)
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-Google-Credentials: {{googleCredentials}}

{
    "command": "ls -la"
}

### 6. Execute Docker Code Server Command
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker run -d -e PUID=1000 -e PGID=1000 -e TZ=Etc/UTC -e PASSWORD=password -e HASHED_PASSWORD= -e SUDO_PASSWORD=password -e SUDO_PASSWORD_HASH= -e DEFAULT_WORKSPACE=/config/workspace -e S3_ACCESS_KEY_ID={{s3AccessKeyId}} -e S3_SECRET_ACCESS_KEY={{s3SecretAccessKey}} -e S3_BUCKET=code-server -e S3_ENDPOINT={{s3EndPoint}} -e S3_REGION={{s3Region}} -e INIT_FILE=init-code-server.sh -e GIT_USER_NAME=erikfva -e GIT_USER_EMAIL=erik.vargas@yandex.com -e TOKEN_NGROK={{tokenNgrok}} -e HTTPS_PORTS=8443,8081 -p 8443:8443 -p 8081:8081 -p 3000:3000 -v /config:/config -v /var/run/docker.sock:/var/run/docker.sock --restart unless-stopped --privileged --device /dev/fuse --cap-add SYS_ADMIN --security-opt apparmor=unconfined --network=host erikvargas/code-server:latest"
}

### 7. Execute Docker PS
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker ps"
}

### 8. Read HTTPS URL File From Code Server Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker exec $(docker ps -q --filter ancestor=erikvargas/code-server:latest) cat /config/workspace/https_url.txt"
}

### 8.1. Expose port 8443 From Code Server Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "CS_ID=$(docker ps -q --filter ancestor=erikvargas/code-server:latest); docker exec $CS_ID sh -lc \"nohup cloudflared tunnel --url http://localhost:8443 --no-autoupdate > /tmp/cloudflared-8443.log 2>&1 & sleep 1; tail -n 20 /tmp/cloudflared-8443.log\""
}

### 8.2. Read 8443 logs From Cloudflare
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker exec $(docker ps -q --filter ancestor=erikvargas/code-server:latest) cat /tmp/cloudflared-8443.log"
}

### 8.3. Display logs From Code Server Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker logs $(docker ps -q --filter ancestor=erikvargas/code-server:latest)"
}

### 9. Delete Code Server Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "CONTAINER_ID=$(docker ps -q --filter ancestor=erikvargas/code-server:latest); docker stop $CONTAINER_ID; docker rm $CONTAINER_ID"
}

### 10. Execute Docker alpine 
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker run -d alpine tail -f /dev/null"
}

### 11. Delete Alpine Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "ALPINE_ID=$(docker ps -q --filter ancestor=alpine); docker stop $ALPINE_ID; docker rm $ALPINE_ID"
}

### 12. Terminate and Remove Session
DELETE {{baseUrl}}/sessions/{{sessionId}}
X-Server-Token: {{serverToken}}

### 13. Terminate All Sessions
POST {{baseUrl}}/sessions/terminate-all
X-Server-Token: {{serverToken}}

### 14. List Available Google Credentials
GET {{baseUrl}}/sessions/google-credentials
X-Server-Token: {{serverToken}}

### 14.2. List Available CodeSandbox Credentials
GET {{baseUrl}}/sessions/codesandbox-credentials
X-Server-Token: {{serverToken}}

###
# CodeSandbox Provider Tests
# Requires the LAB-005 implementation and a CodeSandbox credential JSON file
# sent through x-codesandbox-credentials or request body credentialRef.

@codeSandboxTitle = lab-codesandbox-smoke-test
@codeSandboxCredentials = codesandbox/sistemamedical.json

### 15. List Supported Providers - Should Include codesandbox
GET {{baseUrl}}/sessions/providers/supported
X-Server-Token: {{serverToken}}

### 16. Create a CodeSandbox Session
# @name createCodeSandboxSessionDefault
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-CodeSandbox-Credentials: {{codeSandboxCredentials}}

{
    "provider": "codesandbox",
    "title": "{{codeSandboxTitle}}",
    "privacy": "public-hosts",
    "vmTier": "Nano",
    "hibernationTimeoutSeconds": 86400
}

### 16.1. Create a CodeSandbox Session with custom Credentials Header
# Sends the CodeSandbox credential JSON file reference explicitly.
# @name createCodeSandboxSession
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-CodeSandbox-Credentials: {{codeSandboxCredentials}}

{
    "provider": "codesandbox",
    "title": "{{codeSandboxTitle}}-with-credentials",
    "privacy": "public-hosts",
    "vmTier": "Nano",
    "hibernationTimeoutSeconds": 86400
}

###
@codeSandboxSessionId = {{createCodeSandboxSession.response.body.$.id}}
#@codeSandboxSessionId = d169511c-0b81-4cc0-836e-0a8e36680179
#@codeSandboxDockerHost = {{createCodeSandboxSession.response.body.$.dockerHost}}

### 17. Get CodeSandbox Session Details
GET {{baseUrl}}/sessions/{{codeSandboxSessionId}}
X-Server-Token: {{serverToken}}

### 18. Execute Command in CodeSandbox Session
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "pwd && echo codesandbox-command-ok"
}

### 19. Execute Basic Shell Command in CodeSandbox Session
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker ps"
}

### 19.1 Execute Basic Shell Command in CodeSandbox Session
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "free -h && lscpu"
}

### 19.2 Verify Prepared Docker Socket TCP Proxy from CodeSandbox Host
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "echo DOCKER_HOST=$DOCKER_HOST && docker version"
}

### 19.3 Verify Prepared Docker Socket TCP Proxy from a Container
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker run --rm -e DOCKER_HOST docker:cli docker version"
}

### 19.4 Prepare workspace directory for code
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "mkdir -p /tmp/config"
}

### 19.5 Create Code Server Container in CodeSandbox Session
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker run -d --add-host dockerhost:192.168.241.2 -e HOME=/tmp/config -e DOCKER_HOST -e PUID=1000 -e PGID=1000 -e TZ=Etc/UTC -e PASSWORD=password -e HASHED_PASSWORD= -e SUDO_PASSWORD=password -e SUDO_PASSWORD_HASH= -e DEFAULT_WORKSPACE=/tmp/config/workspace -e S3_ACCESS_KEY_ID={{s3AccessKeyId}} -e S3_SECRET_ACCESS_KEY={{s3SecretAccessKey}} -e S3_BUCKET=code-server -e S3_ENDPOINT={{s3EndPoint}} -e S3_REGION={{s3Region}} -e INIT_FILE=init-code-server.sh -e GIT_USER_NAME=erikfva -e GIT_USER_EMAIL=erik.vargas@yandex.com -e TOKEN_NGROK={{tokenNgrok}} -e HTTPS_PORTS=8443,8081 -p 8443:8443 -p 8081:8081 -p 3000:3000 -v /tmp/config:/config -v /tmp/config:/tmp/config --restart unless-stopped --privileged --device /dev/fuse --cap-add SYS_ADMIN --security-opt apparmor=unconfined erikvargas/code-server:latest"
}

### 19.6 Read HTTPS URL File From Code Server Container
POST {{baseUrl}}/sessions/{{codeSandboxSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker exec $(docker ps -q --filter ancestor=erikvargas/code-server:latest) cat /config/workspace/https_url.txt"
}

### 20. Terminate CodeSandbox Session
DELETE {{baseUrl}}/sessions/{{codeSandboxSessionId}}
X-Server-Token: {{serverToken}}

### 21. Reject Non-Docker CodeSandbox Template
# Expected: 400 CODESANDBOX_TEMPLATE_UNSUPPORTED.
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codesandbox",
    "title": "non-docker-template-check",
    "templateId": "node"
}

### 22. CodeSandbox Create Without Credential Reference
# Expected: 400 CODESANDBOX_CREDENTIALS_MISSING.
# Expected: structured configuration error and no persisted session.
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codesandbox",
    "title": "missing-config-check"
}

###
# GitHub Codespaces Provider Tests
# Requires the LAB-008 implementation and a GitHub PAT with the `codespace`
# scope, sent through x-codespaces-credentials or body credentialRef.

@codespacesTitle = lab-codespaces-smoke-test
@codespacesCredentials = codespaces/vmmanager-1.json

### 23. List Supported Providers - Should Include codespaces
GET {{baseUrl}}/sessions/providers/supported
X-Server-Token: {{serverToken}}

### 24. List Available Codespaces Credentials
GET {{baseUrl}}/sessions/codespaces-credentials
X-Server-Token: {{serverToken}}

### 25. List Codespaces Sessions Only
GET {{baseUrl}}/sessions?provider=codespaces
X-Server-Token: {{serverToken}}

### 26. Create a Codespaces Session
# @name createCodespacesSession
POST {{baseUrl}}/sessions
Content-Type: application/json
X-Server-Token: {{serverToken}}
X-Codespaces-Credentials: {{codespacesCredentials}}

{
    "provider": "codespaces",
    "title": "{{codespacesTitle}}"
}

###
@codespacesSessionId = {{createCodespacesSession.response.body.$.id}}
#@codespacesSessionId = 00000000-0000-0000-0000-000000000000

### 27. Get Codespaces Session Details
GET {{baseUrl}}/sessions/{{codespacesSessionId}}
X-Server-Token: {{serverToken}}

### 28. Execute Command in Codespaces Session
# Commands use the credentialRef stored on the session row at create time —
# the x-codespaces-credentials header is only honored on create.
POST {{baseUrl}}/sessions/{{codespacesSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "pwd && echo codespaces-command-ok"
}

### 28.1. Execute Docker PS in Codespaces Session
POST {{baseUrl}}/sessions/{{codespacesSessionId}}/command
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "command": "docker ps"
}

###
# @codespacesSessionId = c7363fac-a8e0-4b43-9360-d0349aa55ad2

### 29. Terminate Codespaces Session
DELETE {{baseUrl}}/sessions/{{codespacesSessionId}}
X-Server-Token: {{serverToken}}

###
# LAB-009 Provider Credential Status and Availability Tests
# Validates the normalized credential status contract per spec §8-§10.
# Each credential returns: provider, credential, credentialFingerprint,
# status (AVAILABLE|UNAVAILABLE|INVALID|EXPIRED|QUOTA_EXHAUSTED|LIMITED|UNKNOWN),
# checkedAt, expiresAt, quotas[] (quotaUnit, quotaPeriod, usage), details.limitations

### 30. List GCS Credential Status - All Discovered Credentials
# Expected: 200 { provider:"gcs", mode, credentials:[{ provider, credential, credentialFingerprint, status, checkedAt, expiresAt, quotas:[{quotaUnit:"hours", quotaPeriod:"week", usage:null, limit:50}], details:{validated, limitations, localActiveSessions:null, referenceLimits}}] }
# GCS usage is always null with a limitation explaining the REST API does not expose remaining hours.
GET {{baseUrl}}/sessions/gcs/credentials/status
X-Server-Token: {{serverToken}}

### 31. Check Single GCS Credential Status
# credentialRef may contain slashes, so it is passed as a query param (spec §8.2).
# Expected: 200 single entry with same shape as list; status AVAILABLE if credential valid, INVALID/EXPIRED/UNAVAILABLE otherwise.
GET {{baseUrl}}/sessions/gcs/credentials/status?credentialRef={{googleCredentials}}
X-Server-Token: {{serverToken}}

### 32. List CodeSandbox Credential Status - All Discovered Credentials
# Expected: 200 { provider:"codesandbox", mode, credentials:[{ status, quotas:[{quotaUnit:"count", quotaPeriod:"hourly-window", usage, limit, remaining, resetAt}, {quotaUnit:"count", quotaPeriod:null, usage, limit, remaining}, {quotaUnit:"credits", quotaPeriod:"billing-cycle", usage:null}], details:{referencePricing, authScopes, referenceLimits}}] }
# Live headroom from getMetaInfo(): 401/403 → INVALID, remaining===0 → QUOTA_EXHAUSTED, otherwise AVAILABLE; LIMITED if local session exists for fingerprint.
GET {{baseUrl}}/sessions/codesandbox/credentials/status
X-Server-Token: {{serverToken}}

###
@codeSandboxCredentials = vm-manager232-santi.json

### 33. Check Single CodeSandbox Credential Status
# Expected: 200 single entry; verify quotaUnit values are normalized (count, credits) and quotaPeriod null for instantaneous concurrent_vms.
GET {{baseUrl}}/sessions/codesandbox/credentials/status?credentialRef={{codeSandboxCredentials}}
X-Server-Token: {{serverToken}}

### 34. List Codespaces Credential Status - All Discovered Credentials
# Expected: 200 { provider:"codespaces", mode, credentials:[{ status, quotas:[{quotaUnit:"core-hours", quotaPeriod:"month", usage, limit, remaining}, {quotaUnit:"GB-month", quotaPeriod:"month", usage, limit, remaining}], details:{referenceLimits, plan, adoptable, adoptedCodespaceState}}] }
# adoptable===0 → UNAVAILABLE with adopt-don't-create reason; billing usage null with limitation when Plan permission missing; compute in core-hours not clock hours.
GET {{baseUrl}}/sessions/codespaces/credentials/status
X-Server-Token: {{serverToken}}

###
@codespacesCredentials = vm-manager234.json

### 35. Check Single Codespaces Credential Status
# Expected: 200 single entry; plan "pro" → limit 180 core-hours / 20 GB-month, otherwise 120 / 15; remaining derived as limit-usage when billing accessible.
GET {{baseUrl}}/sessions/codespaces/credentials/status?credentialRef={{codespacesCredentials}}
X-Server-Token: {{serverToken}}

### 36. Credential Status - Unknown Provider Should Return 404
# Expected: 404 { code:"CREDENTIAL_STATUS_UNSUPPORTED" }
GET {{baseUrl}}/sessions/unknown/credentials/status
X-Server-Token: {{serverToken}}

### 37. Credential Status - PWD Provider Not Supported Should Return 404
# Expected: 404 { code:"CREDENTIAL_STATUS_UNSUPPORTED" }  - pwd exists in factory but is explicitly blocked for status checks.
GET {{baseUrl}}/sessions/pwd/credentials/status
X-Server-Token: {{serverToken}}

### 38. Credential Status - Unresolvable Credential Ref Returns UNKNOWN (200)
# Expected: 200 { status:"UNKNOWN", details:{ errorCode, errorMessage:"Credential status could not be determined." } }  - per NFR resilience, not 4xx.
GET {{baseUrl}}/sessions/codesandbox/credentials/status?credentialRef=codesandbox/does-not-exist.json
X-Server-Token: {{serverToken}}

### 39. Credential Status - Cache Check (Repeat List Should Hit 5-Minute TTL)
# Expected: 200 same as #32 but served from status-cache (no upstream call) when credential Fingerprint unchanged and status != UNKNOWN.
GET {{baseUrl}}/sessions/codesandbox/credentials/status
X-Server-Token: {{serverToken}}
