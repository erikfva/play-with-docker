DELETE {{baseUrl}}/vps/00000000-0000-0000-0000-000000000000
X-Server-Token: {{serverToken}}

### 37.2. Delete VPS — Blocked by Active Session (Expected: 409 VPS_IN_USE)
# Register a credential, create a session with it, then attempt to delete
# the VPS record while the session is still non-terminal.
# Step A: register
# @name createVpsForBlockTest
POST {{baseUrl}}/vps
Content-Type: application/json
X-Server-Token: {{serverToken}}

{
    "provider": "codespaces",
    "name": "vm-block-test",
    "credentialFileName": "vm-block-test.json",
    "credentialContent": "{\"token\":\"ghp_block_test_placeholder\"}"
}

###
@vpsBlockTestId = {{createVpsForBlockTest.response.body.$.id}}

