@baseUrl = http://localhost:3000/api/v1
@s3AccessKeyId = ET
@s3SecretAccessKey = PM
@tokenNgrok = 3M

### 1. Health Check
GET http://localhost:3000/health

### 2. List Active Sessions
GET {{baseUrl}}/sessions?status=RUNNING

### 3. Create a New Cloud Shell Session
# This will trigger the Google Cloud Shell start-up process
# @name createSession
POST {{baseUrl}}/sessions
Content-Type: application/json

###
#@sessionId = 21327c99-5ac5-4a6f-9630-de6fb418c821 
@sessionId = {{createSession.response.body.$.id}}

### 4. Get Session Details and Status
# Use the ID returned from the POST request above
GET {{baseUrl}}/sessions/{{sessionId}}

### 5. Execute a Command (Requires SSH setup)
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "ls -la"
}

### 6. Execute Docker Code Server Command
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "docker run -d -e PUID=1000 -e PGID=1000 -e TZ=Etc/UTC -e PASSWORD=password -e HASHED_PASSWORD= -e SUDO_PASSWORD=password -e SUDO_PASSWORD_HASH= -e DEFAULT_WORKSPACE=/config/workspace -e S3_ACCESS_KEY_ID={{s3AccessKeyId}} -e S3_SECRET_ACCESS_KEY={{s3SecretAccessKey}} -e S3_BUCKET=code-server -e S3_ENDPOINT=https://f0q5.or.idrivee2-51.com -e INIT_FILE=init-code-server.sh -e GIT_USER_NAME=erikfva -e GIT_USER_EMAIL=erik.vargas@yandex.com -e TOKEN_NGROK={{tokenNgrok}} -e HTTPS_PORTS=8443,8081 -p 8443:8443 -p 8081:8081 -p 3000:3000 -v /config:/config -v /var/run/docker.sock:/var/run/docker.sock --restart unless-stopped --privileged --device /dev/fuse --cap-add SYS_ADMIN --security-opt apparmor=unconfined --network=host erikvargas/code-server:latest"
}

### 7. Execute Docker PS
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "docker ps"
}

### 8. Read HTTPS URL File From Code Server Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "docker exec $(docker ps -q --filter ancestor=erikvargas/code-server:latest) cat /config/workspace/https_url.txt"
}

### 8.1. Expose port 8443 From Code Server Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "CS_ID=$(docker ps -q --filter ancestor=erikvargas/code-server:latest); docker exec $CS_ID sh -lc \"nohup cloudflared tunnel --url http://localhost:8443 --no-autoupdate > /tmp/cloudflared-8443.log 2>&1 & sleep 1; tail -n 20 /tmp/cloudflared-8443.log\""
}

### 9. Delete Code Server Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "CONTAINER_ID=$(docker ps -q --filter ancestor=erikvargas/code-server:latest); docker stop $CONTAINER_ID; docker rm $CONTAINER_ID"
}

### 10. Execute Docker alpine 
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "docker run -d alpine tail -f /dev/null"
}

### 11. Delete Alpine Container
POST {{baseUrl}}/sessions/{{sessionId}}/command
Content-Type: application/json

{
    "command": "ALPINE_ID=$(docker ps -q --filter ancestor=alpine); docker stop $ALPINE_ID; docker rm $ALPINE_ID"
}

### 12. Terminate and Remove Session
DELETE {{baseUrl}}/sessions/{{sessionId}}
